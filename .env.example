# KAGUYA Configuration
DATABASE_URL=sqlite+aiosqlite:///./kaguya.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kaguya

# LLM Integration
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# Personality defaults
DEFAULT_DECAY_RATE=0.05
DEFAULT_LEARNING_RATE=0.01
MAX_INTERACTION_HISTORY=1000
